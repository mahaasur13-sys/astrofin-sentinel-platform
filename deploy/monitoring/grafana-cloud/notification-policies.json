{
  "apiVersion": 1,
  "policies": [
    {
      "receiver": "email-alerts",
      "group_by": ["severity", "component"],
      "group_wait": "30s",
      "group_interval": "5m",
      "repeat_interval": "30m",
      "routes": [
        {
          "receiver": "email-alerts",
          "object_matchers": [["severity", "=", "critical"]],
          "group_wait": "10s",
          "group_interval": "2m",
          "repeat_interval": "5m"
        }
      ]
    }
  ]
}
