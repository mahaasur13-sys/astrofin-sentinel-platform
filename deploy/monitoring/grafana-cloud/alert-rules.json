{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "astrofin_critical",
      "folder": "AstroFin",
      "interval": "30s",
      "rules": [
        {
          "uid": "astrofin-exporter-absent",
          "title": "AstroFin Exporter Absent",
          "condition": "A",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "grafanacloud-mahaasur13-prom",
              "model": {
                "expr": "absent(astrofin_up{component=\"metrics_server\"})",
                "intervalMs": 30000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            }
          ],
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "for": "2m",
          "annotations": {
            "summary": "AstroFin metrics exporter не отправляет метрики в Grafana Cloud",
            "description": "Метрика astrofin_up{component=\"metrics_server\"} отсутствует. Либо exporter (scripts/metrics_exporter.py :9191) не запущен, либо prometheus-cloud remote_write не работает, либо host.docker.internal не резолвится.",
            "runbook_url": "https://github.com/mahaasur13-sys/astrofin-sentinel-platform/blob/master/RUNBOOK.md#exporter-absent"
          },
          "labels": {
            "severity": "critical",
            "team": "astrofin",
            "component": "exporter"
          }
        },
        {
          "uid": "astrofin-exporter-down",
          "title": "AstroFin Exporter Down",
          "condition": "A",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "grafanacloud-mahaasur13-prom",
              "model": {
                "expr": "astrofin_up{component=\"metrics_server\"} == 0",
                "intervalMs": 30000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            }
          ],
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "for": "2m",
          "annotations": {
            "summary": "AstroFin exporter работает, но health check = 0",
            "description": "Метрика astrofin_up == 0. Exporter запущен, но сигнализирует о внутренней ошибке (REGISTRY не инициализирован или metrics_server упал).",
            "runbook_url": "https://github.com/mahaasur13-sys/astrofin-sentinel-platform/blob/master/RUNBOOK.md#exporter-down"
          },
          "labels": {
            "severity": "critical",
            "team": "astrofin",
            "component": "exporter"
          }
        },
        {
          "uid": "rag-metrics-absent",
          "title": "RAG Metrics Absent",
          "condition": "A",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "grafanacloud-mahaasur13-prom",
              "model": {
                "expr": "absent(astrofin_rag_chunk_count)",
                "intervalMs": 30000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            }
          ],
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "for": "5m",
          "annotations": {
            "summary": "Метрики RAG (knowledge layer) отсутствуют в Grafana Cloud",
            "description": "Метрика astrofin_rag_queries_total не найдена. RAG-модуль (knowledge/) не эмитит метрики или не загружен в exporter.",
            "runbook_url": "https://github.com/mahaasur13-sys/astrofin-sentinel-platform/blob/master/RUNBOOK.md#rag-absent"
          },
          "labels": {
            "severity": "critical",
            "team": "astrofin",
            "component": "rag"
          }
        },
        {
          "uid": "evolution-metrics-absent",
          "title": "Meta-RL Evolution Metrics Absent",
          "condition": "A",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "grafanacloud-mahaasur13-prom",
              "model": {
                "expr": "absent(astrofin_evolution_runs_total)",
                "intervalMs": 30000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            }
          ],
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "for": "10m",
          "annotations": {
            "summary": "Метрики Meta-RL evolution отсутствуют в Grafana Cloud",
            "description": "Метрика astrofin_evolution_runs_total не найдена. meta_rl/metrics.py не зарегистрировал метрики в REGISTRY.",
            "runbook_url": "https://github.com/mahaasur13-sys/astrofin-sentinel-platform/blob/master/RUNBOOK.md#evolution-absent"
          },
          "labels": {
            "severity": "critical",
            "team": "astrofin",
            "component": "meta_rl"
          }
        }
      ]
    },
    {
      "orgId": 1,
      "name": "astrofin_warning",
      "folder": "AstroFin",
      "interval": "1m",
      "rules": [
        {
          "uid": "broker-errors-elevated",
          "title": "Broker Errors Elevated",
          "condition": "A",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "grafanacloud-mahaasur13-prom",
              "model": {
                "expr": "rate(astrofin_broker_errors_total[5m]) > 0.05",
                "intervalMs": 60000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            }
          ],
          "noDataState": "NoData",
          "execErrState": "Error",
          "for": "5m",
          "annotations": {
            "summary": "Ошибки брокера (trading execution) превышают порог",
            "description": "rate(astrofin_broker_errors_total[5m]) = {{ $values.A.Value }}/s. Проверьте подключение к Binance и состояние trading/execution/order_book.py.",
            "runbook_url": "https://github.com/mahaasur13-sys/astrofin-sentinel-platform/blob/master/RUNBOOK.md#broker-errors"
          },
          "labels": {
            "severity": "warning",
            "team": "astrofin",
            "component": "trading"
          }
        },
        {
          "uid": "rag-error-rate-elevated",
          "title": "RAG Chunk Count Zero",
          "condition": "A",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "grafanacloud-mahaasur13-prom",
              "model": {
                "expr": "astrofin_rag_chunk_count == 0",
                "intervalMs": 60000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            }
          ],
          "noDataState": "NoData",
          "execErrState": "Error",
          "for": "5m",
          "annotations": {
            "summary": "RAG index empty (0 chunks)",
            "description": "astrofin_rag_chunk_count == 0. Index not built or was cleared.",
            "runbook_url": "https://github.com/mahaasur13-sys/astrofin-sentinel-platform/blob/master/RUNBOOK.md#rag-errors"
          },
          "labels": {
            "severity": "warning",
            "team": "astrofin",
            "component": "rag"
          }
        },
        {
          "uid": "exporter-scrape-stalled",
          "title": "Exporter Scrape Stalled",
          "condition": "A",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "grafanacloud-mahaasur13-prom",
              "model": {
                "expr": "rate(astrofin_exporter_scrapes_total[5m]) == 0",
                "intervalMs": 60000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            }
          ],
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "for": "5m",
          "annotations": {
            "summary": "Prometheus-cloud перестал скрейпить exporter",
            "description": "rate(astrofin_exporter_scrapes_total[5m]) == 0. prometheus-cloud потерял связь с exporter на host.docker.internal:9191.",
            "runbook_url": "https://github.com/mahaasur13-sys/astrofin-sentinel-platform/blob/master/RUNBOOK.md#scrape-stalled"
          },
          "labels": {
            "severity": "warning",
            "team": "astrofin",
            "component": "exporter"
          }
        },
        {
          "uid": "agent-selection-dormant",
          "title": "Agent Selection Dormant",
          "condition": "A",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 1800,
                "to": 0
              },
              "datasourceUid": "grafanacloud-mahaasur13-prom",
              "model": {
                "expr": "absent(astrofin_agent_selection_counts)",
                "intervalMs": 120000,
                "maxDataPoints": 43200,
                "refId": "A"
              }
            }
          ],
          "noDataState": "NoData",
          "execErrState": "Error",
          "for": "15m",
          "annotations": {
            "summary": "Agent selection metric absent",
            "description": "astrofin_agent_selection_counts not found in Prometheus.",
            "runbook_url": "https://github.com/mahaasur13-sys/astrofin-sentinel-platform/blob/master/RUNBOOK.md#agents-dormant"
          },
          "labels": {
            "severity": "warning",
            "team": "astrofin",
            "component": "agents"
          }
        }
      ]
    }
  ]
}