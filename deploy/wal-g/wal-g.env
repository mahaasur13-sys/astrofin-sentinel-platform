# WAL-G Backup Configuration — AstroFin Sentinel V5
# Sprint A (2026-07-25): Production DB backup strategy
#
# Two modes:
#   1. FILE (local dev / single node): WALG_FILE_PREFIX
#   2. S3  (production): WALG_S3_PREFIX + AWS credentials
#
# Fetch wal-g binary: https://github.com/wal-g/wal-g/releases
# Or use Docker image: ghcr.io/wal-g/wal-g:latest

# ── PostgreSQL connection ──────────────────────────────────────────────
# wal-g reads PGDATA, PGHOST, etc. from the postgres container env.
# PGHOST=postgres is already set in docker-compose.yml.
PGUSER=astrofin
PGPASSWORD=${POSTGRES_PASSWORD}
PGDATABASE=astrofin
PGHOST=postgres
PGPORT=5432

# ── Storage target ─────────────────────────────────────────────────────
# --- Local filesystem (dev / single-node) ---
WALG_FILE_PREFIX=/var/lib/postgresql/backups
# --- S3 (production) ---
# Uncomment these and set in .env or GitHub Secrets:
# WALG_S3_PREFIX=s3://astrofin-backups/wal-g
# AWS_ACCESS_KEY_ID=${WALG_AWS_ACCESS_KEY_ID}
# AWS_SECRET_ACCESS_KEY=${WALG_AWS_SECRET_ACCESS_KEY}
# AWS_REGION=eu-central-1

# ── Compression ────────────────────────────────────────────────────────
WALG_COMPRESSION_METHOD=brotli
WALG_COMPRESSION_LEVEL=6

# ── Encryption (AES-256-GCM) ───────────────────────────────────────────
# Generate key (one-time): openssl rand -base64 32
# WALG_LIBSODIUM_KEY=${WALG_ENCRYPTION_KEY}
# WALG_ENCRYPTION_KEY_ID=astrofin-v1

# ── WAL archival ───────────────────────────────────────────────────────
WALG_UPLOAD_CONCURRENCY=4
WALG_UPLOAD_DISK_CONCURRENCY=2
# Trigger archive after every WAL segment (16MB)
WALG_ARCHIVE_TIMEOUT=60

# ── Retention ──────────────────────────────────────────────────────────
# Daily backups kept for 30 days; weekly for 3 months
WALG_DELTA_MAX_STEPS=6
# Purging is done via cron, not wal-g settings — see deploy/wal-g/backup-cron.sh
