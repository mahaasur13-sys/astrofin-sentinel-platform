# WAL-G Backup Configuration — AstroFin Sentinel V5
# =============================================================================
# EXAMPLE TEMPLATE — copy to wal-g.env (gitignored) and fill in real values.
#
#   cp deploy/wal-g/wal-g.env.example deploy/wal-g/wal-g.env
#
# THIS FILE IS NOT A LIVE CONFIG. The S3 / encryption lines below are fail-closed
# ${VAR:?} references — they do nothing until real values are set in the
# gitignored deploy/wal-g/wal-g.env. Production Postgres backup is OUT OF COMPOSE
# until a real WALG_S3_PREFIX + encryption key are provided (docs/RUNBOOK.md §Backups).
#
# Helper note: run wal-g from a glibc image (e.g. ubuntu:24.04), not alpine/musl.

# ── PostgreSQL connection ──────────────────────────────────────────────
# wal-g reads PGDATA, PGHOST, etc. from the postgres container env.
PGUSER=astrofin
PGPASSWORD=${POSTGRES_PASSWORD}
PGDATABASE=astrofin
PGHOST=postgres
PGPORT=5432

# ── Storage target (choose ONE) ────────────────────────────────────────
# Local filesystem — dev/single-node ONLY. It lives inside the postgres
# container filesystem and is NOT a durable backup (lost on container/volume
# recreate). Uncomment this instead of the S3 block to use it:
# WALG_FILE_PREFIX=/var/lib/postgresql/backups

# S3 (real AWS S3) — fail-closed: every secret is a ${VAR:?} reference, never a
# literal bucket/key in git. Set the real values in deploy/wal-g/wal-g.env
# (gitignored); create the S3 bucket + IAM credentials separately.
WALG_S3_PREFIX=${WALG_S3_PREFIX:?WALG_S3_PREFIX is required}
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID:?AWS_ACCESS_KEY_ID is required}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY:?AWS_SECRET_ACCESS_KEY is required}
AWS_REGION=${AWS_REGION:-eu-central-1}
# MinIO / local S3-compatible endpoint ONLY — leave unset for real AWS S3.
# host.docker.internal is provided by the archive overlay extra_hosts host-gateway:
# AWS_ENDPOINT=http://host.docker.internal:9000
# AWS_S3_FORCE_PATH_STYLE=true   # required only for MinIO, not for real AWS S3

# ── Compression ────────────────────────────────────────────────────────
WALG_COMPRESSION_METHOD=brotli
WALG_COMPRESSION_LEVEL=6

# ── Encryption (AES-256-GCM) — REQUIRED for S3, never plaintext ────────
# Key only via a secret file (gitignored), never a literal key in git:
WALG_LIBSODIUM_KEY_PATH=/run/secrets/walg_libsodium_key
WALG_LIBSODIUM_KEY_TRANSFORM=hex
WALG_ENCRYPTION_KEY_ID=astrofin-v1

# ── WAL archival ───────────────────────────────────────────────────────
WALG_UPLOAD_CONCURRENCY=4
WALG_UPLOAD_DISK_CONCURRENCY=2
WALG_ARCHIVE_TIMEOUT=60

# ── Retention ──────────────────────────────────────────────────────────
WALG_DELTA_MAX_STEPS=6
